{
    "name": "simtabi/netsapiens-api",
    "description": "PHP SDK for the NetSapiens API v2, with the legacy v1 client kept for existing callers.",
    "keywords": [
        "simtabi",
        "netsapiens",
        "voip",
        "pbx",
        "telephony",
        "api",
        "sdk"
    ],
    "homepage": "https://opensource.simtabi.com/products/simtabi/netsapiens-api",
    "support": {
        "issues": "https://github.com/simtabi/netsapiens-api/issues",
        "source": "https://github.com/simtabi/netsapiens-api",
        "docs": "https://opensource.simtabi.com/documentation/simtabi/netsapiens-api/"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "role": "Developer"
        },
        {
            "name": "Easter Mukora",
            "email": "easter@simtabi.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5",
        "phpfastcache/phpfastcache": "^9.1.3",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\NetSapiens\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\NetSapiens\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "bin": [
        "bin/netsapiens"
    ]
}
